<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_mono_cam'>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://mono_cam</uri>
      <pose>.12 .03 .242 0 0 0</pose>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">.12 .03 .242 0 0 0</pose>
    </joint>
      <!-- SAGE demo: nadir camera 5 m above the drone (sees the drone from the top); negligible mass -->
    <link name="top_cam_link">
      <pose>0 0 0.3 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="top_cam" type="camera">
        <pose>0 0 4.7 0 1.5708 0</pose>
        <always_on>1</always_on>
        <update_rate>2</update_rate>
        <topic>uav_top_cam</topic>
        <camera>
          <horizontal_fov>0.8</horizontal_fov>
          <image><width>448</width><height>448</height></image>
          <clip><near>0.3</near><far>80</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="TopCamJoint" type="fixed">
      <parent>base_link</parent>
      <child>top_cam_link</child>
    </joint>
  </model>
</sdf>
